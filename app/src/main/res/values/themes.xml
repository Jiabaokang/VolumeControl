<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.VolumeControl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7F7FA</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.VolumeControl.Popup" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:colorAccent">#5650A0</item>
    </style>
</resources>
